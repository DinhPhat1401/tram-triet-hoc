rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    // DiscussionPost Validation
    function isValidDiscussionPost(data) {
      return data.keys().hasAll(['id', 'author', 'avatarColor', 'title', 'content', 'category', 'likes', 'repliesCount', 'createdAt'])
        && data.keys().hasOnly(['id', 'author', 'avatarColor', 'title', 'content', 'category', 'likes', 'repliesCount', 'createdAt', 'authorUid', 'avatarUrl'])
        && data.id is string && data.id.size() <= 128
        && data.author is string && data.author.size() <= 100
        && data.avatarColor is string && data.avatarColor.size() <= 50
        && data.title is string && data.title.size() <= 200
        && data.content is string && data.content.size() <= 5000
        && data.category is string && data.category.size() <= 100
        && (data.likes is int || data.likes is float) && data.likes >= 0
        && (data.repliesCount is int || data.repliesCount is float) && data.repliesCount >= 0
        && data.createdAt == request.time
        && (!data.keys().hasAny(['authorUid']) || data.authorUid == null || (data.authorUid is string && data.authorUid == request.auth.uid))
        && (!data.keys().hasAny(['avatarUrl']) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 1000));
    }

    // Comment Validation
    function isValidComment(data) {
      return data.keys().hasAll(['id', 'author', 'avatarColor', 'content', 'createdAt'])
        && data.keys().hasOnly(['id', 'author', 'avatarColor', 'content', 'createdAt', 'authorUid', 'avatarUrl'])
        && data.id is string && data.id.size() <= 128
        && data.author is string && data.author.size() <= 100
        && data.avatarColor is string && data.avatarColor.size() <= 50
        && data.content is string && data.content.size() <= 2000
        && data.createdAt == request.time
        && (!data.keys().hasAny(['authorUid']) || data.authorUid == null || (data.authorUid is string && data.authorUid == request.auth.uid))
        && (!data.keys().hasAny(['avatarUrl']) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 1000));
    }

    // Like Document Validation
    function isValidLike(data) {
      return data.keys().hasAll(['userId', 'createdAt'])
        && data.keys().size() == 2
        && data.userId is string && data.userId.size() <= 128
        && data.createdAt == request.time;
    }

    // UserProfile Validation
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid'])
        && data.uid is string && data.uid == request.auth.uid
        && (!data.keys().hasAny(['name']) || (data.name is string && data.name.size() <= 100))
        && (!data.keys().hasAny(['email']) || (data.email is string))
        && (!data.keys().hasAny(['avatarUrl']) || (data.avatarUrl is string))
        && (!data.keys().hasAny(['progress']) || (data.progress is map))
        && (!data.keys().hasAny(['bestScores']) || (data.bestScores is map));
    }

    // Collection: forumPosts
    match /forumPosts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(postId) && isValidDiscussionPost(request.resource.data) && request.resource.data.id == postId;
      
      // Updates: allow likes change, repliesCount change, or profile author/role updates
      allow update: if isSignedIn() && isValidId(postId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.avatarColor == resource.data.avatarColor
        && request.resource.data.title == resource.data.title
        && request.resource.data.content == resource.data.content
        && request.resource.data.category == resource.data.category
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          // Action 1: Like / Unlike
          (
            request.resource.data.author == resource.data.author
            && (request.resource.data.likes == resource.data.likes + 1 || request.resource.data.likes == resource.data.likes - 1)
            && request.resource.data.repliesCount == resource.data.repliesCount
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          )
          ||
          // Action 2: Add Comment
          (
            request.resource.data.author == resource.data.author
            && request.resource.data.repliesCount == resource.data.repliesCount + 1
            && request.resource.data.likes == resource.data.likes
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['repliesCount'])
          )
          ||
          // Action 3: Delete Comment
          (
            request.resource.data.author == resource.data.author
            && request.resource.data.repliesCount == resource.data.repliesCount - 1
            && request.resource.data.likes == resource.data.likes
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['repliesCount'])
          )
          ||
          // Action 4: Update Post Author Identity
          (
            (
              (resource.data.keys().hasAll(['authorUid']) && resource.data.authorUid == request.auth.uid)
              ||
              (!resource.data.keys().hasAll(['authorUid']) && exists(/databases/$(database)/documents/userProfiles/$(resource.data.author)) && get(/databases/$(database)/documents/userProfiles/$(resource.data.author)).data.uid == request.auth.uid)
            )
            && request.resource.data.likes == resource.data.likes
            && request.resource.data.repliesCount == resource.data.repliesCount
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['author', 'authorUid'])
            && request.resource.data.authorUid == request.auth.uid
          )
        );
      
      allow delete: if isSignedIn(); // Allow deleting created thread
    }

    // Subcollection replies (Flat route)
    match /forumPosts/{postId}/replies/{replyId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(replyId) && isValidComment(request.resource.data) && request.resource.data.id == replyId;
      allow update: if isSignedIn()
        && (
          (resource.data.keys().hasAll(['authorUid']) && resource.data.authorUid == request.auth.uid)
          ||
          (!resource.data.keys().hasAll(['authorUid']) && exists(/databases/$(database)/documents/userProfiles/$(resource.data.author)) && get(/databases/$(database)/documents/userProfiles/$(resource.data.author)).data.uid == request.auth.uid)
        )
        && request.resource.data.id == resource.data.id
        && request.resource.data.content == resource.data.content
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['author', 'authorUid'])
        && request.resource.data.authorUid == request.auth.uid;
      allow delete: if isSignedIn(); // Allow deleting comment
    }

    // Subcollection likes (Flat route)
    match /forumPosts/{postId}/likes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(likeId) && isValidLike(request.resource.data) && likeId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(likeId) && likeId == request.auth.uid;
    }

    // Collection: userProfiles
    match /userProfiles/{profileId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isValidUserProfile(request.resource.data);
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid && isValidUserProfile(request.resource.data);
      allow delete: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid);
    }
  }
}
